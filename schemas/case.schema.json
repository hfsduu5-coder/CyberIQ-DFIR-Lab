{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberIQ DFIR Case",
  "type": "object",
  "required": ["schema", "case", "status", "evidence", "timeline"],
  "properties": {
    "schema": {"type": "string"},
    "case": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "evidence": {"type": "array"},
    "timeline": {"type": "array"},
    "findings": {"type": "array"},
    "chain_of_custody": {"type": "array"}
  }
}
